# ROAD.NET Backend Environment Variables

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=roadnet
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JWT
JWT_SECRET=ROADNETSuperSecretKeyForJWTTokenGeneration2026ThatMustBeAtLeast256BitsLongForSecurity
JWT_EXPIRATION=86400000

# File Upload
UPLOAD_DIRECTORY=uploads/
MAX_FILE_SIZE=5242880

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Spring Profile
SPRING_PROFILES_ACTIVE=dev
